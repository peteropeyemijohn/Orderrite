# Orderrite API settings: EXAMPLE FILE WITH FAKE VALUES.
# Copy this file to "apps/api/.env" and put real values there.
# apps/api/.env is ignored by git and must never be committed.

# --- Database (Neon) ---
# Where to find these: Neon console -> your project -> "Connect" button.
# Pooled connection ("Connection pooling" ON; the host contains "-pooler").
# Used by the running API.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-000000-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=verify-full"
# Direct connection ("Connection pooling" OFF; no "-pooler" in the host).
# Used by Prisma for migrations and the seed script.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-000000.eu-west-2.aws.neon.tech/neondb?sslmode=verify-full"

# --- Server ---
PORT=4000
# Web addresses allowed to call the API from a browser (comma-separated)
CORS_ORIGINS="http://localhost:3000"

# --- Seed ---
# Phone number of the first admin, in international format.
ADMIN_PHONE="+2348000000000"

# --- Demo ---
# Only "true" in the public demo deployment. NEVER true in a real launch.
DEMO_MODE=false
