# Orderrite mobile settings: EXAMPLE FILE WITH FAKE VALUES.
# Copy this file to "apps/mobile/.env" (ignored by git).
# Everything here is built into the app and is PUBLIC. Never put secrets here.

# Address of the API.
# On a real phone, "localhost" does not work. Use your Mac's Wi-Fi address:
#   run `ipconfig getifaddr en0` in the Terminal, e.g. 192.168.1.20
# The phone and the Mac must be on the same Wi-Fi.
# Later (Phase 2b) this becomes the public Render address.
EXPO_PUBLIC_API_URL="http://192.168.1.20:4000"
