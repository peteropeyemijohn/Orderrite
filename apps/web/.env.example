# Orderrite web settings: EXAMPLE FILE WITH FAKE VALUES.
# Copy this file to "apps/web/.env.local" (ignored by git).

# Where the Next.js SERVER reaches the API. Server-only: never sent to the browser.
# Local: http://localhost:4000. Later (Phase 2b): the Render address.
API_URL="http://localhost:4000"

# Optional (needed from Phase 2b): the same value as WEB_PROXY_SECRET in the API,
# so each web visitor gets their own rate limit. Server-only.
# WEB_PROXY_SECRET=""
