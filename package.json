{
  "name": "orderrite",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:shared": "pnpm --filter shared build",
    "test": "pnpm build:shared && pnpm -r --if-present test",
    "typecheck": "pnpm build:shared && pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "check-secrets": "node scripts/check-secrets.mjs",
    "prepare": "(git config core.hooksPath .githooks || true) && pnpm build:shared",
    "lint": "pnpm -r --if-present lint"
  }
}
